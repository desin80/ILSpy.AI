<UserControl x:Class="ICSharpCode.ILSpy.AIChat.AiChatSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:chat="clr-namespace:ICSharpCode.ILSpy.AIChat"
             mc:Ignorable="d"
             d:DesignHeight="420"
             d:DesignWidth="640"
             d:DataContext="{d:DesignInstance chat:AiChatSettingsViewModel}">
	<StackPanel Orientation="Vertical">
		<GroupBox Header="AI Chat">
			<StackPanel Margin="10">
				<TextBlock TextWrapping="Wrap" Text="AI Chat uses your external Codex CLI configuration." />
				<TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="Install and configure Codex CLI normally (for example npm install -g @openai/codex), then run login/config in your terminal. ILSpy does not store provider/API settings." />
				<TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="Optional: set environment variable ILSPY_CODEX_CLI to override executable path (default: codex)." />
			</StackPanel>
		</GroupBox>
	</StackPanel>
</UserControl>
